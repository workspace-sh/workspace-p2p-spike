{
  "name": "@workspace/p2p-spike-node",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone smoke harness: two NodeRuntime instances find each other via real Hyperswarm and replicate a log.",
  "type": "module",
  "scripts": {
    "smoke": "node --experimental-strip-types --no-warnings src/demos/smoke.ts",
    "demo:end-to-end": "node --experimental-strip-types --no-warnings src/demos/end-to-end.ts",
    "demo:acme": "node --experimental-strip-types --no-warnings src/demos/acme-org.ts",
    "demo:key-delivery": "node --experimental-strip-types --no-warnings src/demos/key-delivery.ts",
    "demo:topic-auth": "node --experimental-strip-types --no-warnings src/demos/topic-auth.ts",
    "demo:workspace": "node --experimental-strip-types --no-warnings src/demos/workspace-sdk.ts",
    "demo:bootstrap": "node --experimental-strip-types --no-warnings src/demos/bootstrap-dht.ts",
    "demo:acme:live": "node --experimental-strip-types --no-warnings src/demos/acme-org-live.ts"
  },
  "dependencies": {
    "@workspace/p2p-runtime": "*",
    "@workspace/portable-bootstrap": "*",
    "@workspace/ucan-boundary": "*",
    "@workspace/workspace": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
