{
  "name": "@workspace.sh/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "App-facing Workspace SDK. One object composing the proven primitives — create/open a workspace, invite members, read/write the encrypted log — so the app codes against a single surface instead of wiring crypto by hand.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@workspace.sh/p2p-runtime": "*",
    "@workspace.sh/portable-bootstrap": "*",
    "@workspace.sh/ucan-boundary": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  }
}
