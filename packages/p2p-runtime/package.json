{
  "name": "@workspace/p2p-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "P2P runtime interface + per-platform implementations. Hypercore + Hyperswarm under the hood.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/runtime.node.ts",
      "default": "./src/runtime.node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "b4a": "1.8.0",
    "corestore": "7.9.2",
    "hyperswarm": "4.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  }
}
