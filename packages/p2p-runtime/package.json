{
  "name": "@workspace/p2p-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "P2P runtime interface + per-platform implementations. Hypercore + Hyperswarm under the hood.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/runtime.node.ts",
      "default": "./src/runtime.node.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  }
}
